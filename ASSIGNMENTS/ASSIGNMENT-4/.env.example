# Environment Configuration Template for Smart Campus Facility Platform
# Copy this file to .env and replace placeholder values.
# NEVER commit real production secrets, passwords, or keys to source control.

APP_NAME="Smart Campus Facility Platform"
APP_VERSION="2.1.0"
ENVIRONMENT="development"
DEBUG=false

# SQLite Database Location
DATABASE_URL="sqlite:///./smart_campus.db"

# JWT Token Cryptographic Configuration
# In production, generate a secure 64-character random key: openssl rand -hex 32
SECRET_KEY="dev-placeholder-secret-key-change-in-production-192524402"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Facility and Sensor Policy Thresholds
DEFAULT_MAX_BOOKING_MINUTES=180
DEFAULT_SENSOR_TEMP_THRESHOLD=28.0

# Service Level Agreement Hours by Priority Tier
SLA_HOURS_M1=2
SLA_HOURS_M2=8
SLA_HOURS_M3=24
SLA_HOURS_M4=72

# External Mock/Staging Integration Endpoints
CALENDAR_SERVICE_URL="https://calendar.campus.internal/api/v1"
ISSUE_TRACKER_URL="https://jira.campus.internal/rest/api/2"
INTEGRATION_TIMEOUT_SECONDS=2.0
MAX_SYNC_RETRIES=3
