# ==============================================================================
# Smart Campus Platform - Environment Configuration Example
# Copy this file to .env and configure appropriate values for deployment.
# NEVER commit .env with real credentials to version control.
# ==============================================================================

# Application Environment
DJANGO_ENV=production
DEBUG=False
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend,backend-1,backend-2

# Database Configuration (PostgreSQL)
POSTGRES_DB=campus
POSTGRES_USER=campus_app
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://campus_app:replace_with_strong_database_password@db:5432/campus

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:80

# External Integrations (Simulated / Production Outbox)
INTEGRATION_TIMEOUT_SECONDS=5
EXTERNAL_TRACKER_URL=https://issues.campus.edu/api/v1
EXTERNAL_TRACKER_API_KEY=placeholder-secret-key

# Deployment Instance Identification
INSTANCE_ID=backend-instance-1
PORT=8000
