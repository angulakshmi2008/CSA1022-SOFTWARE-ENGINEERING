@startuml UseCase_OnlineFoodDelivery
title Online Food Delivery System - Use Case Diagram\nSaveetha School of Engineering | CSA10 | Angulakshmi S (192524402)

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor Customer as C
actor Restaurant as R
actor "Delivery Agent" as DA
actor Administrator as Admin

rectangle "Online Food Delivery Platform" {
    usecase "Login / Authentication" as UC_Login
    usecase "Browse Restaurants" as UC_Browse
    usecase "View Menu & Food Items" as UC_Menu
    usecase "Place Food Order" as UC_Order
    usecase "Make Online Payment" as UC_Pay
    usecase "Track Delivery Status" as UC_Track
    usecase "Manage Menu Items" as UC_ManageMenu
    usecase "Update Order Status" as UC_UpdateStatus
    usecase "Accept Delivery Request" as UC_AcceptDel
    usecase "Update Delivery Progress" as UC_UpdateDel
    usecase "Manage Users & Analytics" as UC_Admin
}

C --> UC_Login
C --> UC_Browse
C --> UC_Menu
C --> UC_Order
C --> UC_Pay
C --> UC_Track

R --> UC_Login
R --> UC_ManageMenu
R --> UC_UpdateStatus

DA --> UC_Login
DA --> UC_AcceptDel
DA --> UC_UpdateDel

Admin --> UC_Login
Admin --> UC_Admin

UC_Order ..> UC_Pay : <<include>>
UC_Track ..> UC_UpdateDel : <<extend>>

@enduml
